---
import { Image } from 'astro:assets';
import { sectionPath } from './paths';
import { editorialImage } from '../lib/images';
import { publication } from '../data/publications';
import { sections } from '../data/news';
import { sectionArtwork } from '../data/visuals';
const dwarvenHalls = [
 { name: 'The council chamber', section: 'Council & Public Life', image: 'council', detail: 'Power, policy and the public record' },
 { name: 'Below the mountain', section: 'Labor & Industry', image: 'forge', detail: 'The people who keep the furnaces burning' },
 { name: 'From gate to stall', section: 'Markets & Trade', image: 'market', detail: 'Trade, caravans and the price of copper' },
 { name: 'Stone & memory', section: 'Memory & Arts', image: 'library', detail: 'Archives, artifacts and the stories we keep' },
];
const halls = publication.id === 'dwarves' ? dwarvenHalls : sections.slice(0, 4).map((section) => ({ name: section, section, image: sectionArtwork(publication, section).name, detail: `Reporting from ${publication.name}` }));
const label = publication.id === 'dwarves' ? 'Explore the halls' : 'Explore the paper';
---
<details class="halls-menu" data-halls-menu>
 <summary>{label} <span aria-hidden="true">+</span></summary>
 <nav class="halls-menu__grid" aria-label={label}>
  {halls.map((hall) => (
   <a href={sectionPath(hall.section)}>
    <template data-hall-photo><Image src={editorialImage(`/images/qsn/${hall.image}.png`)} alt="" width={400} widths={[240, 400]} sizes="(min-width: 700px) 25vw, 50vw" format="webp" loading="eager" /></template>
    <strong>{hall.name}</strong><span>{hall.detail}</span>
   </a>
  ))}
 </nav>
</details>
<script>
 for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-halls-menu]')) {
  menu.addEventListener('toggle', () => {
   if (!menu.open) return;
   for (const template of menu.querySelectorAll<HTMLTemplateElement>('[data-hall-photo]')) {
    template.replaceWith(template.content.cloneNode(true));
   }
  });
 }
</script>
