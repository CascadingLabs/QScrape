---
import SeriesPage from '../../../../components/SeriesPage.astro';
import { series } from '../../../../data/news';
import { articlesBySeriesId } from '../../../../components/news-index';
import { LIST_PAGE_SIZE } from '../../../../components/paths';

export function getStaticPaths() {
	return series.flatMap((item) => {
		const stories = articlesBySeriesId.get(item.id) ?? [];
		const total = stories.length;
		const pageCount = Math.max(1, Math.ceil(total / LIST_PAGE_SIZE));
		return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
			const page = index + 2;
			return {
				params: { id: item.id, page: String(page) },
				props: {
					series: item,
					articles: stories.slice((page - 1) * LIST_PAGE_SIZE, page * LIST_PAGE_SIZE),
					total,
					page,
					pageCount,
				},
			};
		});
	});
}

const { series: collection, articles, total, page, pageCount } = Astro.props;
---

<SeriesPage
	series={collection}
	articles={articles}
	total={total}
	page={page}
	pageCount={pageCount}
/>
