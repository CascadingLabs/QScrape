---
import { LIST_PAGE_SIZE } from '../../../components/paths';
import { publication } from '../../../data/publications';
import NewsLayout from '../../../layouts/NewsLayout.astro';
import StoryArchive from '../../../components/StoryArchive.astro';
import { articles } from '../../../data/news';
import { orderedArticles } from '../../../components/news-index';

const pageSize = LIST_PAGE_SIZE;
const ordered = orderedArticles;
const pageCount = Math.max(1, Math.ceil(ordered.length / pageSize));
export function getStaticPaths() {
	const count = Math.max(1, Math.ceil(articles.length / LIST_PAGE_SIZE));
	return Array.from({ length: count - 1 }, (_, index) => index + 2).map((page) => ({ params: { page: String(page) }, props: { page } }));
}

const { page } = Astro.props;
const stories = ordered.slice((page - 1) * pageSize, page * pageSize);
---

<NewsLayout title={`Story Archive · Page ${page}`} description={`Browse ${publication.shortName} reporting by publication date.`}>
	<div class="archive-page">
		<header class="page-heading page-heading--wide">
			<p class="eyebrow">The complete record</p>
			<h1>Story archive</h1>
			<p>Page {page}: reporting filed in chronological order.</p>
		</header>
		<div class="archive-toolbar">
			<p>Showing stories {(page - 1) * pageSize + 1}–{Math.min(page * pageSize, ordered.length)} of {ordered.length.toLocaleString('en')}</p>
			<a class="text-link" href="/search/">Search all reporting <span aria-hidden="true">→</span></a>
		</div>
		<StoryArchive articles={stories} page={page} pageCount={pageCount} />
	</div>
</NewsLayout>
