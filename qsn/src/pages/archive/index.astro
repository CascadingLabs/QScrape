---
import { LIST_PAGE_SIZE } from '../../components/paths';
import { publication } from '../../data/publications';
import NewsLayout from '../../layouts/NewsLayout.astro';
import StoryArchive from '../../components/StoryArchive.astro';
import { orderedArticles } from '../../components/news-index';

const ordered = orderedArticles;
const pageSize = LIST_PAGE_SIZE;
const pageCount = Math.max(1, Math.ceil(ordered.length / pageSize));
const firstPage = ordered.slice(0, pageSize);
---

<NewsLayout title="Story Archive" description={`Browse the ${publication.shortName} reporting archive.`}>
	<div class="archive-page">
		<header class="page-heading page-heading--wide">
			<p class="eyebrow">The complete record</p>
			<h1>Story archive</h1>
			<p>Every dispatch, investigation and account filed by {publication.shortName}, arranged from newest to oldest.</p>
		</header>
		<div class="archive-toolbar">
			<p>{ordered.length.toLocaleString('en')} stories</p>
			<a class="text-link" href="/search/">Search all reporting <span aria-hidden="true">→</span></a>
		</div>
		<StoryArchive articles={firstPage} page={1} pageCount={pageCount} />
	</div>
</NewsLayout>
