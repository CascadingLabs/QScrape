---
import { LIST_PAGE_SIZE } from '../../../../components/paths';
import { publication } from '../../../../data/publications';
import NewsLayout from '../../../../layouts/NewsLayout.astro';
import StoryArchive from '../../../../components/StoryArchive.astro';
import { sections } from '../../../../data/news';
import { orderedArticles } from '../../../../components/news-index';
import { sectionPath } from '../../../../components/paths';

const pageSize = LIST_PAGE_SIZE;
export function getStaticPaths() {
	return sections.flatMap((section) => {
		const stories = orderedArticles.filter((article) => article.section.toLowerCase() === section.toLowerCase());
		const count = Math.ceil(stories.length / LIST_PAGE_SIZE);
		return Array.from({ length: Math.max(0, count - 1) }, (_, index) => index + 2).map((page) => ({
			params: { section: sectionPath(section).split('/')[2], page: String(page) },
			props: { section, page },
		}));
	});
}

const { section, page } = Astro.props;
const stories = orderedArticles.filter((article) => article.section.toLowerCase() === section.toLowerCase());
const pageCount = Math.max(1, Math.ceil(stories.length / pageSize));
const pageStories = stories.slice((page - 1) * pageSize, page * pageSize);
---

<NewsLayout title={`${section} · Page ${page}`} description={`Page ${page} of ${publication.shortName} reporting from ${section}.`} section={section}>
	<div class="section-page">
		<header class="page-heading">
			<p class="eyebrow">{publication.shortName} desk</p>
			<h1>{section}</h1>
			<p>Dispatches, investigation and analysis from the {section.toLowerCase()} desk.</p>
		</header>
		<div class="archive-toolbar">
			<p>Stories {(page - 1) * pageSize + 1}–{Math.min(page * pageSize, stories.length)} of {stories.length.toLocaleString('en')}</p>
			<a class="text-link" href={sectionPath(section)}>Back to {section} front <span aria-hidden="true">→</span></a>
		</div>
		<StoryArchive articles={pageStories} page={page} pageCount={pageCount} basePath={sectionPath(section)} />
	</div>
</NewsLayout>
