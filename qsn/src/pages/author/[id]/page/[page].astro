---
import AuthorPage from '../../../../components/AuthorPage.astro';
import { authors } from '../../../../data/news';
import { articlesByAuthorId } from '../../../../components/news-index';
import { LIST_PAGE_SIZE } from '../../../../components/paths';

export function getStaticPaths() {
	return authors.flatMap((author) => {
		const stories = articlesByAuthorId.get(author.id) ?? [];
		const total = stories.length;
		const pageCount = Math.max(1, Math.ceil(total / LIST_PAGE_SIZE));
		return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
			const page = index + 2;
			return {
				params: { id: author.id, page: String(page) },
				props: {
					author,
					articles: stories.slice((page - 1) * LIST_PAGE_SIZE, page * LIST_PAGE_SIZE),
					total,
					page,
					pageCount,
					latestPublishedAt: stories[0]?.publishedAt,
				},
			};
		});
	});
}

const { author, articles, total, page, pageCount, latestPublishedAt } = Astro.props;
---

<AuthorPage
	author={author}
	articles={articles}
	total={total}
	page={page}
	pageCount={pageCount}
	latestPublishedAt={latestPublishedAt}
/>
