---
import { publication } from '../data/publications';
import NewsLayout from '../layouts/NewsLayout.astro';
---

<NewsLayout title="Story not found" description={`This page is not part of the ${publication.shortName} archive.`}>
	<section class="not-found">
		<p class="eyebrow">A missing dispatch</p>
		<h1>We couldn’t find that page.</h1>
		<p>The address may have changed, or the story may have been withdrawn from the record.</p>
		<div class="not-found__links">
			<a class="button button--dark" href="/">Return to the latest edition</a>
			<a class="text-link" href="/archive/">Browse the archive <span aria-hidden="true">→</span></a>
		</div>
	</section>
</NewsLayout>
