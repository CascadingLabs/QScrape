---
const enabled = import.meta.env.PUBLIC_L3_GUARD !== 'false';
---
{enabled && <script is:inline>
(function(){var D=2500,M=document.querySelector('main');if(!M)return;setTimeout(function(){var W=document.createElement('vm-shield');var S=W.attachShadow({mode:'closed'});document.querySelectorAll('style,link[rel="stylesheet"]').forEach(function(s){S.appendChild(s.cloneNode(true))});while(M.firstChild)S.appendChild(M.firstChild);M.appendChild(W)},D)})();
</script>}
