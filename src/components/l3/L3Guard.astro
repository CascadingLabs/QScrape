---
const enabled = import.meta.env.PUBLIC_L3_GUARD !== 'false';
---
{enabled && <Fragment>
<div aria-hidden="true" style="position:fixed;bottom:-1px;left:0;width:100%;height:1px;overflow:hidden;opacity:0.001;pointer-events:auto;z-index:-1;">
