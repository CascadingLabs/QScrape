<script is:inline>
	(function () {
		function getCookie(name) {
			var m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
			return m ? decodeURIComponent(m[1]) : null;
		}

		// Cross-site sync: read cl-theme and cl-lang from inbound links
		var params = new URLSearchParams(window.location.search);
		var dirty = false;

		var inbound = params.get("cl-theme");
		if (inbound === "light" || inbound === "dark" || inbound === "auto") {
			var storeVal = inbound === "light" || inbound === "dark" ? inbound : "auto";
			document.cookie = "cl-theme=" + storeVal + "; path=/; max-age=31536000; SameSite=Lax";
			localStorage.setItem("starlight-theme", inbound === "auto" ? "" : inbound);
			params.delete("cl-theme");
			dirty = true;
		}

		var inboundLang = params.get("cl-lang");
		if (inboundLang && /^[a-z]{2}(-[A-Za-z]{2,})?$/.test(inboundLang)) {
			document.cookie = "cl-lang=" + inboundLang + "; path=/; max-age=31536000; SameSite=Lax";
			params.delete("cl-lang");
			dirty = true;
		}

		if (dirty) {
			var clean = params.toString();
			history.replaceState(null, "", window.location.pathname + (clean ? "?" + clean : "") + window.location.hash);
		}

		var c = getCookie("cl-theme");
		var s = c || localStorage.getItem("starlight-theme");
		var pref = s === "light" || s === "dark" ? s : "auto";
		var resolved =
			pref === "auto"
				? window.matchMedia("(prefers-color-scheme: light)").matches
					? "light"
					: "dark"
				: pref;
		document.documentElement.dataset.theme = resolved;
		document.documentElement.dataset.themePreference = pref;

		// Always ensure cookie + localStorage exist (handles cleared/missing state)
		var cookieVal = pref === "light" || pref === "dark" ? pref : "auto";
		document.cookie = "cl-theme=" + cookieVal + "; path=/; max-age=31536000; SameSite=Lax";
		localStorage.setItem("starlight-theme", pref === "auto" ? "" : pref);
	})();
</script>
