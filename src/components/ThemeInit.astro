<script is:inline>
	(() => {
		const root = document.documentElement;
		const system = window.matchMedia('(prefers-color-scheme: dark)');
		const valid = (value) => ['light', 'dark', 'auto'].includes(value);
		const params = new URLSearchParams(location.search);
		const incoming = params.get('cl-theme');
		const cookie = document.cookie.match(
			/(?:^|;\s*)cl-theme=(light|dark|auto)(?:;|$)/,
		);
		let preference = valid(incoming) ? incoming : cookie?.[1] || 'auto';
		function persist() {
			document.cookie = `cl-theme=${preference}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
			try {
				localStorage.setItem(
					'starlight-theme',
					preference === 'auto' ? '' : preference,
				);
			} catch {
				/* Cookies remain the preference source. */
			}
		}
		if (valid(incoming)) {
			params.delete('cl-theme');
			const query = params.toString();
			history.replaceState(
				history.state,
				'',
				`${location.pathname}${query ? `?${query}` : ''}${location.hash}`,
			);
		}
		const hosts = new Set([
			'cascadinglabs.com',
			'www.cascadinglabs.com',
			'qscrape.dev',
			'www.qscrape.dev',
		]);
		function carryPreference(link) {
			if (!(link instanceof HTMLAnchorElement)) return;
			let url;
			try {
				url = new URL(link.href, location.href);
			} catch {
				return;
			}
			if (
				url.protocol !== 'https:' ||
				!hosts.has(url.hostname) ||
				url.origin === location.origin
			)
				return;
			url.searchParams.set('cl-theme', preference);
			link.href = url.href;
		}
		function apply() {
			const theme =
				preference === 'auto'
					? system.matches
						? 'dark'
						: 'light'
					: preference;
			root.dataset.theme = theme;
			root.dataset.themePreference = preference;
			const icon = document.getElementById('site-favicon');
			if (icon)
				icon.href =
					icon.dataset.brand === 'qscrape'
						? theme === 'light'
							? '/favicon-light.svg'
							: '/favicon.svg'
						: `/favicon-${icon.dataset.brand}-${theme}.svg`;
			document.querySelectorAll('[data-theme-logo]').forEach((image) => {
				image.src = theme === 'light' ? '/favicon-light.svg' : '/favicon.svg';
			});
			const label =
				preference === 'auto'
					? 'Auto'
					: preference === 'light'
						? 'Light'
						: 'Dark';
			document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
				button.setAttribute(
					'aria-label',
					`Color theme: ${label}. Click to change.`,
				);
				button.setAttribute('title', `Color theme: ${label}`);
			});
			document.querySelectorAll('a[href]').forEach(carryPreference);
		}
		persist();
		apply();
		system.addEventListener('change', () => {
			if (preference === 'auto') apply();
		});
		document.addEventListener('DOMContentLoaded', apply);
		document.addEventListener('astro:page-load', apply);
		document.addEventListener(
			'click',
			(event) => {
				if (!(event.target instanceof Element)) return;
				if (event.target.closest('[data-theme-toggle]')) {
					preference =
						preference === 'auto'
							? 'light'
							: preference === 'light'
								? 'dark'
								: 'auto';
					persist();
					apply();
				}
				const link = event.target.closest('a[href]');
				if (link) carryPreference(link);
			},
			true,
		);
		window.addEventListener('pageshow', apply);
	})();
</script>
