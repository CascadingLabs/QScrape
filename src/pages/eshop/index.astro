---
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
const repository = 'https://github.com/CascadingLabs/QScrape';
const revision = import.meta.env.PUBLIC_SOURCE_REVISION ?? process.env.CF_PAGES_COMMIT_SHA ?? process.env.GITHUB_SHA;
const sourceRef = typeof revision === 'string' && /^[a-f0-9]{40}$/i.test(revision) ? revision : 'main';
const moduleURL = (module: string) => `${repository}/tree/${sourceRef}/src/modules/${module}`;
const options = [
	{
		slug: 'html', name: 'HTML eShop',
		description: 'Astro generates the catalogue and product pages as static HTML at build time. Read product data directly from the response.',
		renderer: 'Astro-rendered HTML', extraction: 'No JavaScript required',
		interactions: 'Ordinary JavaScript for filters and the sample cart',
		module: 'html-eshop',
	},
	{
		slug: 'javascript', name: 'JavaScript eShop',
		description: 'Astro hosts one client-only React island. Product content appears when the island renders in the browser.',
		renderer: 'Astro + React island', extraction: 'JavaScript required',
		interactions: 'React handles search, filtering, and the sample cart',
		module: 'javascript-eshop',
	},
];
---
<PlaygroundLayout title="eShop — QScrape" description="Compare the HTML and JavaScript versions of the same synthetic eShop.">
	<h1 slot="heading" class="home-title">eShop</h1>
	<div class="home-copy">
		<p>Two implementations of the same six-product shop. Choose what you want your scraper to handle.</p>
		<p><a href="/eshop/fixtures.json">Catalogue fixtures</a> provide the expected product IDs, prices, and stock.</p>
	</div>
	<section class="version-list" aria-label="eShop versions">
		{options.map((option) => (
			<article class="version-link">
				<div class="version-heading"><h2>{option.name}</h2></div>
				<p>{option.description}</p>
				<dl class="version-details">
					<div><dt>Rendering</dt><dd>{option.renderer}</dd></div>
					<div><dt>Extraction</dt><dd>{option.extraction}</dd></div>
					<div><dt>Interactions</dt><dd>{option.interactions}</dd></div>
					<div><dt>Navigation</dt><dd>Separate pages with ordinary links</dd></div>
				</dl>
				<a class="project-card version-open" href={`/eshop/${option.slug}/`}>Open {option.name}<span class="project-arrow" aria-hidden="true">→</span></a>
				<a class="version-module" href={moduleURL(option.module)} target="_blank" rel="noopener noreferrer">GitHub implementation ↗</a>
			</article>
		))}
	</section>
	<div class="home-footer"><a href="/">← QScrape</a></div>
</PlaygroundLayout>
