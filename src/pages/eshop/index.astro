---
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
const options = [
	{ slug: 'html', name: 'HTML eShop', description: 'Product content is in the HTML response. No JavaScript needed for extraction.' },
	{ slug: 'javascript', name: 'JavaScript eShop', description: 'Product content loads in the browser. Let the page render before extracting.' },
	{ slug: 'protected', name: 'Protected eShop', description: 'The same shop with deliberate extraction challenges.' },
];
---
<PlaygroundLayout title="eShop — QScrape" description="Choose the HTML, JavaScript, or Protected version of the eShop.">
	<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">QScrape</a><span aria-hidden="true">/</span><span aria-current="page">eShop</span></nav>
	<section class="intro" aria-labelledby="picker-title">
		<h1 id="picker-title">eShop</h1>
		<p>Choose a version. Each one uses the same six products.</p>
	</section>
	<nav class="site-list" aria-label="eShop versions">
		{options.map((option) => (
			<a class="site-row" href={`/eshop/${option.slug}/`}>
				<div class="row-heading"><h2>{option.name}</h2><span class="row-arrow" aria-hidden="true">↗</span></div>
				<p>{option.description}</p>
			</a>
		))}
	</nav>
</PlaygroundLayout>
