---
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
const options = [
	{ slug: 'html', name: 'HTML eShop', description: 'Product content is in the HTML response. No JavaScript needed for extraction.' },
	{ slug: 'javascript', name: 'JavaScript eShop', description: 'Product content loads in the browser. Let the page render before extracting.' },
	{ slug: 'protected', name: 'Protected eShop', description: 'The same shop with deliberate extraction challenges.' },
];
---
<PlaygroundLayout title="eShop — QScrape" description="Choose the HTML, JavaScript, or Protected version of the eShop.">
	<h1 slot="heading" class="home-title">eShop</h1>
	<div class="home-copy"><p>Choose a version. Each one uses the same six products.</p></div>
	<nav class="version-list" aria-label="eShop versions">
		{options.map((option) => (
			<a class="version-link" href={`/eshop/${option.slug}/`}>
				<div class="version-heading"><h2>{option.name}</h2><span class="project-arrow" aria-hidden="true">→</span></div>
				<p>{option.description}</p>
			</a>
		))}
	</nav>
	<div class="home-footer"><a href="/">← QScrape</a></div>
</PlaygroundLayout>
