---
import ShopLayout from '../../../../layouts/ShopLayout.astro';
import StaticCart from '../../../../components/eshop/StaticCart.astro';
import ShopClient from '../../../../components/eshop/ShopClient';
import ProtectedShop from '../../../../components/eshop/ProtectedShop';
import { versions, type ShopVersion } from '../../../../data/eshop/catalog';

export function getStaticPaths() {
	return versions.map((version) => ({ params: { version }, props: { version } }));
}

interface Props {
	version: ShopVersion;
}

const { version } = Astro.props;
const versionLabels: Record<ShopVersion, string> = {
	html: 'HTML eShop',
	javascript: 'JavaScript eShop',
	protected: 'Protected eShop',
};
const title = `Your cart — ${versionLabels[version]}`;
const description = 'Review the objects in your local demo cart.';
---

<ShopLayout title={title} description={description} shopVersion={version}>
	<Fragment slot="head">
		<link rel="canonical" href={`https://qscrape.dev/eshop/${version}/cart/`} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`https://qscrape.dev/eshop/${version}/cart/`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Objects" />
	</Fragment>
	{version === 'html'
		? <StaticCart version={version} />
		: <>
			<noscript><p class="shop-protection-note">{versionLabels[version]} needs JavaScript enabled to view and update the local cart.</p></noscript>
			{version === 'protected' ? <ProtectedShop client:only="react" page="cart" version={version}><p slot="fallback" class="shop-root shop-loading" role="status">Loading shop…</p></ProtectedShop> : <ShopClient client:only="react" page="cart" version={version}><p slot="fallback" class="shop-root shop-loading" role="status">Loading shop…</p></ShopClient>}
		</>}
</ShopLayout>
