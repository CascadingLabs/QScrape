---
import QScrapeLayout from '../../layouts/QScrapeLayout.astro';
---

<QScrapeLayout title="L2 — QScrape">
	<header>
		<div class="breadcrumb">
			<a href="/">QScrape</a> / L2
		</div>
		<div class="logo">Level 2</div>
		<div class="tagline">
			Modern web frameworks — Lit, Svelte, React, Vue
		</div>
	</header>

	<section class="stub-notice">
		<h2>Coming Soon</h2>
		<p>
			Level 2 sites are not available yet. When launched, L2 will feature sites built with modern web frameworks like <a href="https://lit.dev/" target="_blank" rel="noopener">Lit</a>, <a href="https://svelte.dev/" target="_blank" rel="noopener">Svelte</a>, <a href="https://react.dev/" target="_blank" rel="noopener">React</a>, and <a href="https://vuejs.org/" target="_blank" rel="noopener">Vue</a>. These will test scrapers against typical DOM-level changes seen in the wild — shadow DOM, client-side rendering, hydration, and dynamic state.
		</p>
		<a href="/" class="stub-back">← Back to QScrape</a>
	</section>
</QScrapeLayout>
