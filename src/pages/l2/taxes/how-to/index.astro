---
// ── React islands ────────────────────────────────────────────────────────────
import ReactHowTo from '../../../../components/l2/taxes/react/TaxesHowTo';
import ReactHowToInfo from '../../../../components/l2/taxes/react/TaxesHowToInfo';
// ── Solid islands ────────────────────────────────────────────────────────────
import SolidHowTo from '../../../../components/l2/taxes/solid/TaxesHowTo';
import SolidHowToInfo from '../../../../components/l2/taxes/solid/TaxesHowToInfo';
// ── Svelte islands ───────────────────────────────────────────────────────────
import SvelteHowTo from '../../../../components/l2/taxes/svelte/TaxesHowTo.svelte';
import SvelteHowToInfo from '../../../../components/l2/taxes/svelte/TaxesHowToInfo.svelte';
// ── Vue islands ──────────────────────────────────────────────────────────────
import VueHowTo from '../../../../components/l2/taxes/vue/TaxesHowTo.vue';
import VueHowToInfo from '../../../../components/l2/taxes/vue/TaxesHowToInfo.vue';
import ThemeInit from '../../../../components/ThemeInit.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>How-To Guides — Eldoria Registry of Deeds — L2</title>
    <meta name="description" content="Eldoria Registry of Deeds — How-To Filing Guides. QScrape L2 shuffled islands." />
    <ThemeInit />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--er-bg, #f8f9fa);
        color: var(--er-text, #212529);
        font-family: var(--er-font, "IBM Plex Sans", system-ui, sans-serif);
        font-size: 15px;
        line-height: 1.6;
      }

      .er2-header {
        background: var(--er-primary, #1d4ed8);
        border-bottom: 3px solid rgba(0,0,0,0.15);
      }
      .er2-header-top {
        max-width: 1200px;
        margin: 0 auto;
        padding: 14px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .er2-brand { display: flex; align-items: center; gap: 12px; flex: 1; }
      .er2-crest { font-size: 24px; line-height: 1; color: #fff; }
      .er2-title { font-size: 18px; font-weight: 700; color: #fff; letter-spacing: -0.2px; line-height: 1.2; }
      .er2-subtitle { font-size: 11px; color: rgba(255,255,255,0.7); margin-top: 1px; }
      .er2-nav { display: flex; gap: 4px; }
      .er2-nav-link {
        padding: 6px 12px; font-size: 12px; color: rgba(255,255,255,0.7);
        text-decoration: none; border-radius: var(--er-radius, 4px);
        transition: color 0.12s, background 0.12s;
      }
      .er2-nav-link:hover { color: #fff; background: rgba(255,255,255,0.15); }
      .er2-edition { font-size: 11px; color: rgba(255,255,255,0.5); font-style: italic; }

      .er2-layout { max-width: 1200px; margin: 0 auto; padding: 0 0 40px; }
      .er2-main {
        padding: 20px 0 0;
        display: grid;
        grid-template-columns: 1fr 260px;
        gap: 0;
        align-items: start;
      }

      .er2-footer { border-top: 1px solid var(--er-border, #ced4da); background: var(--er-surface, #fff); margin-top: 40px; }
      .er2-footer-inner {
        max-width: 1200px; margin: 0 auto;
        padding: 14px 24px; display: flex;
        justify-content: space-between; flex-wrap: wrap;
        gap: 6px; font-size: 12px; color: var(--er-muted, #6c757d);
      }
    </style>
  </head>
  <body>

    <header class="er2-header">
      <div class="er2-header-top">
        <div class="er2-brand">
          <div class="er2-crest">⚒</div>
          <div>
            <div class="er2-title">Eldoria Registry of Deeds</div>
            <div class="er2-subtitle">Granite Flats County · How-To Filing Guides</div>
          </div>
        </div>
        <nav class="er2-nav">
          <a href="/l2/taxes/" class="er2-nav-link">← Tax Search</a>
          <a href="/l2/taxes/recording-fees/" class="er2-nav-link">Recording Fees</a>
        </nav>
        <span class="er2-edition">L2 · Shuffled Islands</span>
      </div>
    </header>

    <div class="er2-layout">
      <main class="er2-main">
        <div class="er2-slot" data-slot="how-to">
          <div data-fw="react" hidden><ReactHowTo client:only="react" /></div>
          <div data-fw="vue" hidden><VueHowTo client:only="vue" /></div>
          <div data-fw="svelte" hidden><SvelteHowTo client:only="svelte" /></div>
          <div data-fw="solid" hidden><SolidHowTo client:only="solid-js" /></div>
        </div>
        <div class="er2-slot" data-slot="how-to-info">
          <div data-fw="react" hidden><ReactHowToInfo client:only="react" /></div>
          <div data-fw="vue" hidden><VueHowToInfo client:only="vue" /></div>
          <div data-fw="svelte" hidden><SvelteHowToInfo client:only="svelte" /></div>
          <div data-fw="solid" hidden><SolidHowToInfo client:only="solid-js" /></div>
        </div>
      </main>
    </div>

    <footer class="er2-footer">
      <div class="er2-footer-inner">
        <span>Eldoria Registry of Deeds · Granite Flats County · Year 312</span>
        <span>Official records system — for research and informational purposes only</span>
      </div>
    </footer>

    <script>
      (function () {
        const fws = ['react', 'vue', 'svelte', 'solid'];
        document.querySelectorAll('.er2-slot').forEach(function (slot) {
          var fw = fws[Math.floor(Math.random() * fws.length)];
          slot.setAttribute('data-active-fw', fw);
          slot.querySelectorAll('[data-fw]').forEach(function (el) {
            if ((el as HTMLElement).dataset.fw === fw) {
              (el as HTMLElement).removeAttribute('hidden');
            }
          });
        });
      })();
    </script>

    <ThemeToggle />
  </body>
</html>
