---
import QScrapeLayout from '../../layouts/QScrapeLayout.astro';
---

<QScrapeLayout
	title="L1 — Static HTML Scraper Test Sites | QScrape"
	description="QScrape Level 1: four static HTML/CSS/JS test sites built with Astro. No frameworks, no anti-bot measures. A baseline for validating HTML parsing, multi-page navigation, and structured data extraction."
>
	<Fragment slot="head">
		<meta name="keywords" content="static HTML scraper test, web scraping baseline, HTML parsing test site, scraper benchmark level 1, Astro static site scraping" />
		<link rel="canonical" href="https://qscrape.dev/l1/" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://qscrape.dev/l1/" />
		<meta property="og:title" content="L1 — Static HTML Scraper Test Sites | QScrape" />
		<meta property="og:description" content="Four static HTML test sites for scraper benchmarking: a news portal, esports scores tracker, property tax registry, and e-commerce catalogue. No JavaScript required." />
		<meta property="og:site_name" content="QScrape" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="L1 — Static HTML Scraper Test Sites | QScrape" />
		<meta name="twitter:description" content="Four static HTML test sites for scraper benchmarking: a news portal, esports scores tracker, property tax registry, and e-commerce catalogue. No JavaScript required." />

		<!-- JSON-LD: CollectionPage -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": "QScrape Level 1 — Static HTML Test Sites",
			"url": "https://qscrape.dev/l1/",
			"description": "Level 1 of QScrape provides four static HTML/CSS/JS websites built with Astro. All content is rendered at build time. No client-side frameworks, no API calls, and no anti-scraping measures. These sites establish a baseline for verifying HTML parsing, multi-page navigation, and structured data extraction.",
			"isPartOf": {
				"@type": "WebSite",
				"name": "QScrape",
				"url": "https://qscrape.dev/"
			},
			"hasPart": [
				{
					"@type": "WebSite",
					"name": "Mountainhome Herald",
					"description": "Fictional news portal. Tests article listings, pagination, individual article pages, and RSS feeds.",
					"url": "https://qscrape.dev/l1/news/"
				},
				{
					"@type": "WebSite",
					"name": "ScoreTap",
					"description": "Fictional esports scores site. Tests structured tabular data, team/event relationships, and linked detail pages.",
					"url": "https://qscrape.dev/l1/scoretap/"
				},
				{
					"@type": "WebSite",
					"name": "Eldoria Registry of Deeds",
					"description": "Fictional property tax registry. Tests form-like search interfaces, record listings, and document viewer pages.",
					"url": "https://qscrape.dev/l1/taxes/"
				},
				{
					"@type": "WebSite",
					"name": "VaultMart",
					"description": "Fictional e-commerce catalogue. 28 products, 5 categories. Tests sentinel URLs, filter+pagination, cart JSON-LD, dual-price extraction, and stock level attributes.",
					"url": "https://qscrape.dev/l1/eshop/"
				}
			]
		})} />

		<!-- JSON-LD: FAQPage (AEO) -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "What is QScrape Level 1?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "QScrape Level 1 (L1) is a set of four static HTML websites designed to benchmark web scrapers. All content is server-rendered at build time using Astro. There are no JavaScript frameworks, no AJAX calls, and no anti-bot protections — making L1 the easiest baseline level for scraper evaluation."
					}
				},
				{
					"@type": "Question",
					"name": "What test sites are in QScrape L1?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "L1 includes four sites: Mountainhome Herald (a news portal testing article listings and pagination), ScoreTap (an esports scores tracker testing tabular data and detail pages), Eldoria Registry of Deeds (a property tax registry testing search and document viewer flows), and VaultMart (an e-commerce catalogue testing product filters, pagination, cart JSON-LD, and stock attributes)."
					}
				},
				{
					"@type": "Question",
					"name": "Does QScrape L1 require JavaScript to scrape?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "No. All L1 pages are fully server-rendered static HTML. A scraper that only fetches raw HTML — without executing JavaScript — can extract all data from every L1 page."
					}
				}
			]
		})} />
	</Fragment>

    <header>
        <div class="breadcrumb">
            <a href="/">QScrape</a> / L1
        </div>
        <div class="logo">Level 1</div>
        <div class="tagline">
            Standard HTML/CSS/JS — no dynamic data, no web frameworks
        </div>
    </header>

    <section aria-label="What is QScrape Level 1">
        <h2>About</h2>
        <p>
            L1 sites are static pages built with <a
                href="https://astro.build/"
                target="_blank"
                rel="noopener">Astro</a
            >. All content is rendered at build time into plain HTML. There are
            no client-side frameworks, no API calls, and no anti-scraping
            measures. These sites serve as a baseline to verify that a scraper
            can correctly parse real-world HTML structure, navigate multi-page
            sites, and extract structured data.
        </p>
    </section>

    <section>
        <h2>Sites</h2>
        <ul class="card-list">
            <li>
                <a class="card-item" href="/l1/news/">
                    <div class="card-header">
                        <span class="card-label">/l1/news</span>
                        <span class="card-arrow">↗</span>
                    </div>
                    <div class="card-name">Mountainhome Herald</div>
                    <div class="card-desc">
                        News portal with article listings, individual articles,
                        and a rss feeds. Tests pagination and article
                        extraction.
                    </div>
                </a>
            </li>
            <li>
                <a class="card-item" href="/l1/scoretap/">
                    <div class="card-header">
                        <span class="card-label">/l1/scoretap</span>
                        <span class="card-arrow">↗</span>
                    </div>
                    <div class="card-name">ScoreTap</div>
                    <div class="card-desc">
                        Esports scores and match results. Tests structured
                        tabular data, team/event relationships, and linked
                        detail pages.
                    </div>
                </a>
            </li>
            <li>
                <a class="card-item" href="/l1/taxes/">
                    <div class="card-header">
                        <span class="card-label">/l1/taxes</span>
                        <span class="card-arrow">↗</span>
                    </div>
                    <div class="card-name">Eldoria Registry of Deeds</div>
                    <div class="card-desc">
                        Property tax records and deed search. Tests form-like
                        search interfaces, record listings, and document viewer
                        pages.
                    </div>
                </a>
            </li>
            <li>
                <a class="card-item" href="/l1/eshop/">
                    <div class="card-header">
                        <span class="card-label">/l1/eshop</span>
                        <span class="card-arrow">↗</span>
                    </div>
                    <div class="card-name">VaultMart</div>
                    <div class="card-desc">
                        2008-era e-commerce catalogue. 28 products, 5
                        categories. Tests sentinel product URLs,
                        filter+pagination DOM interaction, cart JSON-LD,
                        promoted product deduplication, dual-price sale
                        extraction, stock level attributes, and search
                        &lt;mark&gt; tag handling.
                    </div>
                </a>
            </li>
        </ul>
    </section>
</QScrapeLayout>
