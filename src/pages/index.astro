---
import PlaygroundLayout from '../layouts/PlaygroundLayout.astro';
const description = 'A small playground for testing web scrapers against HTML, JavaScript, and protected sites.';
---
<PlaygroundLayout title="QScrape — Scraper playground" description={description}>
	<Fragment slot="head"><link rel="canonical" href="https://qscrape.dev/" /></Fragment>
	<section class="intro" aria-labelledby="home-title">
		<p class="eyebrow">Beta</p>
		<h1 id="home-title">QScrape</h1>
		<p>{description} Start with the eShop.</p>
	</section>
	<nav class="site-list" aria-label="Test sites">
		<a class="site-row" href="/eshop/">
			<div class="row-heading"><h2>eShop</h2><span class="row-arrow" aria-hidden="true">↗</span></div>
			<p>A fictional catalogue, product pages, and a cart. Three versions of the same shop.</p>
		</a>
	</nav>
</PlaygroundLayout>
