---
import EshopProductImage from '../../../../components/l3/react/eshop/EshopProductImage';
import EshopProductRating from '../../../../components/l3/solid/eshop/EshopProductRating';
import EshopProductDetails from '../../../../components/l3/svelte/eshop/EshopProductDetails.svelte';
import EshopProductName from '../../../../components/l3/vue/eshop/EshopProductName.vue';
import { type ProductMeta, products } from '../../../../data/eshop/products';
import '../../../../styles/l3/eshop.css';
import L3Guard from '../../../../components/l3/L3Guard.astro';
import ShadowShield from '../../../../components/l3/ShadowShield.astro';
import ThemeInit from '../../../../components/ThemeInit.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';

export function getStaticPaths() {
	return products.map((p) => ({
		params: { sku: p.sku },
		props: { product: p },
	}));
}

interface Props {
	product: ProductMeta;
}

const { product } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{product.name} — VaultMart L3</title>
    <meta name="description" content={product.excerpt} />
    <ThemeInit />
  </head>
  <body>
    <header class="a">
      <div class="b">
        <a href="/l3/eshop/" class="c">VaultMart</a>
        <nav class="d">
          <a href="/l3/eshop/" class="e">Home</a>
          <a href="/l3/eshop/cart/" class="e">Cart</a>
          <a href="/l3/" class="e">← L3</a>
        </nav>
        <span class="f">L3 · Islands Edition</span>
      </div>
    </header>

    <main class="g">
      <div class="h">
        <a href="/l3/eshop/">Catalog</a>
        <span>›</span>
        <a href={`/l3/eshop/?cat=${encodeURIComponent(product.category)}`}>{product.category}</a>
        <span>›</span>
        <span>{product.sku}</span>
      </div>

      <div class="i">
        <section class="j">
          <EshopProductImage client:only="react" product={product} />
          <EshopProductName client:only="vue" sku={product.sku} />
        </section>
        <aside class="k">
          <EshopProductDetails client:only="svelte" sku={product.sku} />
          <EshopProductRating client:only="solid-js" sku={product.sku} />
        </aside>
      </div>
    </main>

    <footer class="l">
      <div class="m">
        <span>© 2026 VaultMart</span>
        <span>QScrape L3 · Islands: React · Vue · Svelte · Solid</span>
      </div>
    </footer>
    <ThemeToggle />
    <L3Guard />
    <ShadowShield />
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--vm3-bg);
    color: var(--vm3-text);
    font-family: var(--vm3-font);
    font-size: 16px;
    line-height: 1.6;
  }

  .a {
    background: var(--vm3-surface);
    border-bottom: 1px solid var(--vm3-border);
  }
  .b {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .c {
    font-family: var(--vm3-font);
    font-size: 22px;
    font-weight: 700;
    color: var(--vm3-primary);
    text-decoration: none;
    letter-spacing: -0.3px;
    margin-right: auto;
  }

  .d {
    display: flex;
    gap: 4px;
  }
  .e {
    padding: 7px 14px;
    font-family: var(--vm3-font);
    font-size: 13px;
    font-weight: 500;
    color: var(--vm3-muted);
    text-decoration: none;
    border-radius: var(--vm3-radius);
    transition: color 0.15s, background 0.15s;
  }
  .e:hover { color: var(--vm3-text); background: var(--vm3-surface2); }

  .f {
    font-family: var(--vm3-font);
    font-size: 11px;
    color: var(--vm3-muted);
    font-style: italic;
  }

  .g {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .h {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--vm3-font);
    font-size: 13px;
    color: var(--vm3-muted);
  }
  .h a {
    color: var(--vm3-primary);
    text-decoration: none;
  }
  .h a:hover { text-decoration: underline; }

  .i {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .i { grid-template-columns: 1fr; }
  }

  .j {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .k {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .l {
    border-top: 1px solid var(--vm3-border);
    background: var(--vm3-surface);
    margin-top: 48px;
  }
  .m {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--vm3-font);
    font-size: 12px;
    color: var(--vm3-muted);
  }
</style>
