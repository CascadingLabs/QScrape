---
import QScrapeLayout from '../../layouts/QScrapeLayout.astro';
---

<QScrapeLayout title="L3 — QScrape">
	<header>
		<div class="breadcrumb">
			<a href="/">QScrape</a> / L3
		</div>
		<div class="logo">Level 3</div>
		<div class="tagline">
			Anti-bot sites — no unsolvable CAPTCHAs
		</div>
	</header>

	<section class="stub-notice">
		<h2>Coming Soon</h2>
		<p>
			Level 3 sites are not available yet. When launched, L3 will feature sites with anti-bot defences — fingerprinting, rate limiting, header validation, and behavioural checks. No recaptchas or challenge puzzles that require anti-captcha APIs.
		</p>
		<a href="/" class="stub-back">← Back to QScrape</a>
	</section>
</QScrapeLayout>
