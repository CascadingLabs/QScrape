---
import ScoretapGameFilter from '../../../components/l3/react/scoretap/ScoretapGameFilter';
import ScoretapStandings from '../../../components/l3/solid/scoretap/ScoretapStandings';
import ScoretapLiveTicker from '../../../components/l3/svelte/scoretap/ScoretapLiveTicker.svelte';
import ScoretapEvents from '../../../components/l3/vue/scoretap/ScoretapEvents.vue';
import '../../../styles/l3/scoretap.css';
import ThemeInit from '../../../components/ThemeInit.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ScoreTap — L3</title>
    <meta name="description" content="ScoreTap esports scores — QScrape L3 islands test site." />
    <ThemeInit />
  </head>
  <body>
    <header class="a">
      <div class="b">
        <a href="/l3/scoretap/" class="c">
          <span class="d">Score<span class="e">Tap</span></span>
        </a>
        <nav class="f">
          <a href="/l3/scoretap/" class="g h">Home</a>
          <a href="/l3/scoretap/teams/" class="g">Teams</a>
          <a href="/l3/" class="g i">&larr; L3</a>
        </nav>
      </div>
    </header>

    <main class="j">
      <div class="k">
        <section class="l">
          <ScoretapGameFilter client:only="react" />
          <ScoretapEvents client:only="vue" />
        </section>
        <aside class="m">
          <ScoretapLiveTicker client:only="svelte" />
          <ScoretapStandings client:only="solid-js" />
        </aside>
      </div>
    </main>

    <footer class="n">
      <div class="o">
        <span>&copy; 2026 ScoreTap</span>
        <span>QScrape L3 &middot; Islands: React &middot; Vue &middot; Svelte &middot; Solid</span>
      </div>
    </footer>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--st3-bg);
    color: var(--st3-text);
    font-family: var(--st3-font-ui);
    font-size: 16px;
    line-height: 1.6;
    min-height: 100vh;
  }

  .a {
    background: var(--st3-surface);
    border-bottom: 1px solid var(--st3-border);
  }
  .b {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .c {
    text-decoration: none;
    flex-shrink: 0;
  }
  .d {
    font-family: var(--st3-font-ui);
    font-size: 20px;
    font-weight: 700;
    color: var(--st3-text);
    letter-spacing: -0.5px;
  }
  .e {
    color: var(--st3-live);
  }

  .f {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }
  .g {
    padding: 7px 14px;
    font-family: var(--st3-font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--st3-muted);
    text-decoration: none;
    border-radius: var(--st3-radius);
    transition: background 0.15s, color 0.15s;
  }
  .g:hover {
    background: var(--st3-surface2);
    color: var(--st3-text);
  }
  .h {
    color: var(--st3-text);
    background: var(--st3-surface2);
  }
  .i {
    margin-left: 8px;
    border-left: 1px solid var(--st3-border);
    border-radius: 0;
    padding-left: 16px;
  }

  .j {
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px 24px 48px;
  }

  .k {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 28px;
  }
  @media (max-width: 768px) {
    .k { grid-template-columns: 1fr; }
  }

  .l {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  .m {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .n {
    border-top: 1px solid var(--st3-border);
    background: var(--st3-surface);
    margin-top: auto;
  }
  .o {
    max-width: 1100px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--st3-font-ui);
    font-size: 12px;
    color: var(--st3-muted);
  }
</style>
