---
import NewsHeadlines from '../../../components/l3/react/news/NewsHeadlines';
import NewsStaffPanel from '../../../components/l3/solid/news/NewsStaffPanel';
import NewsSidebar from '../../../components/l3/svelte/news/NewsSidebar.svelte';
import NewsFeed from '../../../components/l3/vue/news/NewsFeed.vue';
import '../../../styles/l3/news.css';
import L3Guard from '../../../components/l3/L3Guard.astro';
import ThemeInit from '../../../components/ThemeInit.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mountainhome Herald — L3</title>
    <meta name="description" content="Mountainhome Herald — QScrape L3 islands test site." />
    <ThemeInit />
  </head>
  <body>
    <header class="a">
      <div class="b">
        <span class="c" id="_0"></span>
        <a href="/l3/news/" class="d">
          <span class="e">Mountainhome Herald</span>
          <span class="f">The Voice of the Deep</span>
        </a>
        <span class="g">L3 · Islands Edition</span>
      </div>
      <nav class="h">
        <div class="i">
          <a href="/l3/news/" class="j k">Home</a>
          <a href="/l3/news/articles/" class="j">Articles</a>
          <a href="/l3/" class="j">← L3</a>
        </div>
      </nav>
    </header>

    <main class="l">
      <div class="m">
        <section class="n">
          <NewsHeadlines client:only="react" />
          <NewsFeed client:only="vue" />
        </section>
        <aside class="o">
          <NewsSidebar client:only="svelte" />
          <NewsStaffPanel client:only="solid-js" />
        </aside>
      </div>
    </main>

    <footer class="p">
      <div class="q">
        <span>© 2026 Mountainhome Herald</span>
        <span>QScrape L3 · Islands: React · Vue · Svelte · Solid</span>
      </div>
    </footer>
    <ThemeToggle />
    <L3Guard />
  </body>
</html>

<script>
  document.getElementById('_0')!.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--hn3-bg);
    color: var(--hn3-text);
    font-family: var(--hn3-font-body);
    font-size: 16px;
    line-height: 1.6;
  }

  .a {
    background: var(--hn3-masthead-bg);
    color: var(--hn3-masthead-text);
  }
  .b {
    max-width: 1100px;
    margin: 0 auto;
    padding: 18px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .c {
    font-family: var(--hn3-font-body);
    font-size: 11px;
    color: #777;
  }
  .d {
    text-align: center;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .e {
    display: block;
    font-family: var(--hn3-font-display);
    font-size: clamp(22px, 3.5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.1;
    color: var(--hn3-masthead-text);
  }
  .f {
    display: block;
    font-size: 11px;
    color: #777;
    margin-top: 3px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .g {
    font-family: var(--hn3-font-body);
    font-size: 11px;
    color: #777;
    text-align: right;
    font-style: italic;
  }

  .h {
    border-bottom: 2px solid var(--hn3-accent);
    background: #1a1a1a;
  }
  .i {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
  }
  .j {
    padding: 11px 16px;
    font-family: var(--hn3-font-body);
    font-size: 13px;
    font-weight: 500;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
  }
  .j:hover { color: #fff; }
  .k { color: #fff; border-bottom-color: var(--hn3-accent); }

  .l {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .m {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 32px;
  }
  @media (max-width: 768px) {
    .m { grid-template-columns: 1fr; }
  }

  .n {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .o {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .p {
    border-top: 1px solid var(--hn3-border);
    background: var(--hn3-masthead-bg);
    margin-top: 48px;
  }
  .q {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--hn3-font-body);
    font-size: 12px;
    color: #666;
  }
</style>
