---
import TaxesDocumentHeader from '../../../../components/l3/react/taxes/TaxesDocumentHeader';
import TaxesRelatedDocs from '../../../../components/l3/solid/taxes/TaxesRelatedDocs';
import TaxesPdfLink from '../../../../components/l3/svelte/taxes/TaxesPdfLink.svelte';
import TaxesOwnerDetails from '../../../../components/l3/vue/taxes/TaxesOwnerDetails.vue';
import { type DeedRecord, deeds } from '../../../../data/taxes/deeds';
import '../../../../styles/l3/taxes.css';
import L3Guard from '../../../../components/l3/L3Guard.astro';
import ThemeInit from '../../../../components/ThemeInit.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';

export async function getStaticPaths() {
	return deeds.map((deed) => ({
		params: { id: deed.fileNum },
		props: { deed },
	}));
}

interface Props {
	deed: DeedRecord;
}
const { deed } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{deed.fileNum} — Eldoria Registry of Deeds L3</title>
    <ThemeInit />
  </head>
  <body>
    <header class="a">
      <div class="b">
        <span class="c">🛡</span>
        <div class="d">
          <span class="e">Eldoria Registry of Deeds</span>
          <span class="f">Official Property Records · L3 Islands Edition</span>
        </div>
        <span class="g">QScrape · L3</span>
      </div>
      <nav class="h">
        <div class="i">
          <a href="/l3/taxes/" class="j">Search</a>
          <a href="/l3/" class="j">← L3</a>
        </div>
      </nav>
    </header>

    <main class="k">
      <div class="l">
        <div class="m">
          <TaxesDocumentHeader client:only="react" deed={deed} />
          <TaxesOwnerDetails client:only="vue" fileNum={deed.fileNum} />
        </div>
        <aside class="n">
          <TaxesPdfLink client:only="svelte" fileNum={deed.fileNum} />
          <TaxesRelatedDocs client:only="solid-js" fileNum={deed.fileNum} />
        </aside>
      </div>
    </main>

    <footer class="o">
      <div class="p">
        <span>© 2027 Eldoria Registry of Deeds</span>
        <span>QScrape L3 · Islands: React · Vue · Svelte · Solid</span>
      </div>
    </footer>
    <ThemeToggle />
    <L3Guard />
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--er3-bg);
    color: var(--er3-text);
    font-family: var(--er3-font);
    font-size: 16px;
    line-height: 1.6;
  }

  .a {
    background: var(--er3-surface);
    border-bottom: 1px solid var(--er3-border);
  }
  .b {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
  }

  .c {
    font-size: 28px;
    line-height: 1;
    filter: hue-rotate(160deg);
  }

  .d {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .e {
    display: block;
    font-family: var(--er3-font);
    font-size: clamp(18px, 2.5vw, 28px);
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.1;
    color: var(--er3-primary);
  }
  .f {
    display: block;
    font-size: 11px;
    color: var(--er3-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .g {
    font-family: var(--er3-font);
    font-size: 11px;
    color: var(--er3-muted);
    text-align: right;
    font-style: italic;
  }

  .h {
    border-bottom: 2px solid var(--er3-primary);
    background: var(--er3-surface2);
  }
  .i {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
  }
  .j {
    padding: 10px 16px;
    font-family: var(--er3-font);
    font-size: 13px;
    font-weight: 500;
    color: var(--er3-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: color 0.15s;
  }
  .j:hover { color: var(--er3-text); }

  .k {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .l {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
  }
  @media (max-width: 768px) {
    .l { grid-template-columns: 1fr; }
  }

  .m {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .n {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .o {
    border-top: 1px solid var(--er3-border);
    background: var(--er3-surface);
    margin-top: 48px;
  }
  .p {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--er3-font);
    font-size: 12px;
    color: var(--er3-muted);
  }
</style>
