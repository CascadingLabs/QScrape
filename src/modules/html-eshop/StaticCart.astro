---
import type { ShopVersion } from '../../data/eshop/catalog';

interface Props {
	version: ShopVersion;
}

const { version } = Astro.props;
---

<div
	class="shop-root shop-frame"
	data-shop-part="html-shop-cart"
	data-shop-version={version}
>
	<header class="shop-topline">
		<a class="shop-wordmark" href={`/eshop/${version}/`}>
			Objects
		</a>
		<nav class="shop-nav" aria-label="Objects shop">
			<a href={`/eshop/${version}/`}>Shop</a>
			<a
				href={`/eshop/${version}/cart/`}
				aria-current="page"
				data-shop-part="cart-nav"
			>
				Cart{' '}
				<span class="shop-bag-count" data-html-cart-count>
					0
				</span>
			</a>
		</nav>
	</header>
	<section class="shop-cart-heading" aria-labelledby="cart-title">
		<p class="eyebrow">Your Objects</p>
		<h1 id="cart-title">Cart</h1>
		<p>Review the products in your cart.</p>
	</section>
	<div class="shop-empty-cart" data-html-cart-empty>
		<p>Your bag is empty for now.</p>
		<a href={`/eshop/${version}/`}>Find something useful</a>
	</div>
	<div class="shop-cart-layout" data-html-cart-content hidden>
		<ul
			class="shop-cart-list"
			data-html-cart-lines
			aria-label="Items in your bag"
		></ul>
		<aside class="shop-cart-summary" aria-label="Order summary">
			<h2>Order summary</h2>
			<p class="shop-summary-row">
				<span>Items</span>
				<span data-html-cart-subtotal>$0.00</span>
			</p>
			<p class="shop-summary-row">
				<span>Shipping</span>
				<span>On us</span>
			</p>
			<p class="shop-summary-row shop-summary-total">
				<strong>Total</strong>
				<strong data-html-cart-total>$0.00</strong>
			</p>
		</aside>
	</div>
	<noscript>
		<p class="shop-notice">
			Turn on JavaScript to view and update items saved in this browser’s cart.
		</p>
	</noscript>
	<p
		class="shop-html-live-message"
		data-html-cart-status
		role="status"
		aria-live="polite"
	></p>
	<footer class="shop-footer">
		<span>Objects · Thoughtful things for everyday living</span>
	</footer>
</div>

<script>
	import { formatPrice, products } from '../../data/eshop/catalog';
	import {
		cartStorageKey,
		readCart,
		writeCart,
	} from '../../lib/eshop/cart-store';

	const root = document.querySelector<HTMLElement>(
		'[data-shop-part="html-shop-cart"]',
	);
	if (root) {
		const version = root.dataset.shopVersion ?? 'html';
		const emptyState = root.querySelector<HTMLElement>(
			'[data-html-cart-empty]',
		);
		const content = root.querySelector<HTMLElement>('[data-html-cart-content]');
		const lines = root.querySelector<HTMLUListElement>(
			'[data-html-cart-lines]',
		);
		const totalNode = root.querySelector<HTMLElement>('[data-html-cart-total]');
		const subtotalNode = root.querySelector<HTMLElement>(
			'[data-html-cart-subtotal]',
		);
		const countNode = root.querySelector<HTMLElement>('[data-html-cart-count]');
		const status = root.querySelector<HTMLElement>('[data-html-cart-status]');

		const render = () => {
			const cart = readCart(version, products);
			const count = cart.reduce((sum, line) => sum + line.quantity, 0);
			const subtotal = cart.reduce((sum, line) => {
				const product = products.find((item) => item.id === line.productId);
				return sum + (product?.price ?? 0) * line.quantity;
			}, 0);
			if (countNode) countNode.textContent = String(count);
			if (subtotalNode) subtotalNode.textContent = formatPrice(subtotal);
			if (totalNode) totalNode.textContent = formatPrice(subtotal);
			if (emptyState) emptyState.hidden = cart.length > 0;
			if (content) content.hidden = cart.length === 0;
			if (!lines) return;
			lines.replaceChildren();

			for (const line of cart) {
				const product = products.find((item) => item.id === line.productId);
				if (!product) continue;
				const item = document.createElement('li');
				item.className = 'shop-cart-line';
				item.dataset.cartProductId = product.id;

				const image = document.createElement('img');
				image.className = 'shop-cart-thumb';
				image.src = product.image;
				image.alt = `${product.name}, ${product.color}`;
				image.width = 600;
				image.height = 480;
				item.append(image);

				const details = document.createElement('div');
				const link = document.createElement('a');
				link.className = 'shop-cart-item-name';
				link.href = `/eshop/${version}/product/${encodeURIComponent(product.id)}/`;
				link.textContent = product.name;
				const meta = document.createElement('p');
				meta.className = 'shop-cart-item-meta';
				meta.textContent = `${product.category} · ${product.color} · ${formatPrice(product.price)} each`;
				const quantity = document.createElement('div');
				quantity.className = 'shop-quantity';
				const decrease = document.createElement('button');
				decrease.type = 'button';
				decrease.dataset.cartAction = 'decrease';
				decrease.setAttribute(
					'aria-label',
					`Decrease ${product.name} quantity`,
				);
				decrease.textContent = '−';
				const amount = document.createElement('span');
				amount.setAttribute(
					'aria-label',
					`${line.quantity} ${product.name} in cart`,
				);
				amount.textContent = String(line.quantity);
				const increase = document.createElement('button');
				increase.type = 'button';
				increase.dataset.cartAction = 'increase';
				increase.setAttribute(
					'aria-label',
					`Increase ${product.name} quantity`,
				);
				increase.textContent = '+';
				increase.disabled = line.quantity >= product.stock;
				const remove = document.createElement('button');
				remove.type = 'button';
				remove.className = 'shop-remove-button';
				remove.dataset.cartAction = 'remove';
				remove.setAttribute('aria-label', `Remove ${product.name}`);
				remove.textContent = 'Remove';
				quantity.append(decrease, amount, increase, remove);
				details.append(link, meta, quantity);
				item.append(details);

				const total = document.createElement('span');
				total.className = 'shop-line-total';
				total.textContent = formatPrice(product.price * line.quantity);
				item.append(total);
				lines.append(item);
			}
		};

		render();
		window.addEventListener('storage', (event) => {
			if (event.key === cartStorageKey(version) || event.key === null) render();
		});
		lines?.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest<HTMLButtonElement>('[data-cart-action]');
			const item = button?.closest<HTMLElement>('[data-cart-product-id]');
			const productId = item?.dataset.cartProductId;
			if (!button || !productId) return;
			const cart = readCart(version, products);
			const line = cart.find((entry) => entry.productId === productId);
			const product = products.find((entry) => entry.id === productId);
			if (!line || !product) return;
			let next = cart;
			if (
				button.dataset.cartAction === 'remove' ||
				(button.dataset.cartAction === 'decrease' && line.quantity <= 1)
			) {
				next = cart.filter((entry) => entry.productId !== productId);
			} else if (button.dataset.cartAction === 'decrease') {
				next = cart.map((entry) =>
					entry.productId === productId
						? { ...entry, quantity: Math.max(1, entry.quantity - 1) }
						: entry,
				);
			} else if (button.dataset.cartAction === 'increase') {
				next = cart.map((entry) =>
					entry.productId === productId
						? {
								...entry,
								quantity: Math.min(product.stock, entry.quantity + 1),
							}
						: entry,
				);
			}
			const result = writeCart(version, next, products);
			if (!result.persisted) {
				if (status)
					status.textContent =
						'Browser storage is unavailable, so this cart change could not be saved.';
				return;
			}
			if (status)
				status.textContent =
					button.dataset.cartAction === 'remove'
						? `Removed ${product.name} from cart.`
						: `Updated ${product.name} quantity.`;
			render();
		});
	}
</script>
