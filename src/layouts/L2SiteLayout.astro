---
import ThemeInit from '../components/ThemeInit.astro';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      .l2-island-label {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 17, 23, 0.88);
        border-bottom: 2px solid #2d3148;
        backdrop-filter: blur(8px);
        padding: 6px 16px;
        font-family: system-ui, sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .l2-island-label::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
      }
      .l2-island[data-fw="react"] .l2-island-label { color: #61dafb; border-color: #61dafb33; }
      .l2-island[data-fw="vue"]   .l2-island-label { color: #42b883; border-color: #42b88333; }
      .l2-island[data-fw="svelte"] .l2-island-label { color: #ff3e00; border-color: #ff3e0033; }
      .l2-island[data-fw="solid"] .l2-island-label { color: #446b9e; border-color: #446b9e33; }
      .l2-island + .l2-island {
        border-top: 3px solid #1a1d2e;
      }
    </style>
    <ThemeInit />
  </head>
  <body>
    <div class="l2-island" data-fw="react">
      <div class="l2-island-label">React</div>
      <slot name="react" />
    </div>
    <div class="l2-island" data-fw="vue">
      <div class="l2-island-label">Vue</div>
      <slot name="vue" />
    </div>
    <div class="l2-island" data-fw="svelte">
      <div class="l2-island-label">Svelte</div>
      <slot name="svelte" />
    </div>
    <div class="l2-island" data-fw="solid">
      <div class="l2-island-label">Solid</div>
      <slot name="solid" />
    </div>
  </body>
</html>
