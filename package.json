{
	"name": "galactic-group",
	"type": "module",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.11",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"check": "biome check --write --no-errors-on-unmatched .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@astrojs/react": "^5.0.2",
		"@astrojs/sitemap": "^3.7.1",
		"@astrojs/solid-js": "^6.0.1",
		"@astrojs/svelte": "^8.0.4",
		"@astrojs/vue": "^6.0.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.1.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"solid-js": "^1.9.12",
		"svelte": "^5.55.0",
		"vue": "^3.5.31"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"start-server-and-test": "^3.0.0"
	}
}
